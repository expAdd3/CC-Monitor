{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Monitor",
  "version": "0.1.0",
  "identifier": "com.lixinyu.ccmonitor",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "dashboard",
        "title": "CC Monitor",
        "width": 1080,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/cc-monitor-hook"],
    "icon": ["../assets/AppIcon.icns"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
